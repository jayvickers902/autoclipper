# Copy to .env (chmod 600). Never commit .env.

# Private Discord channel webhook for test posts (channel settings > Integrations > Webhooks).
DISCORD_TEST_WEBHOOK_URL=

# Clip judge: Claude through the `claude` CLI on Jay's subscription. No API key anywhere.
AUTOCLIPPER_JUDGE=claude-cli
AUTOCLIPPER_JUDGE_MODEL=claude-haiku-5-5
AUTOCLIPPER_POLISH_MODEL=claude-sonnet-5-5
AUTOCLIPPER_JUDGE_MAX_CALLS_PER_HOUR=60
AUTOCLIPPER_POLISH_MAX_CALLS_PER_DAY=30
# Pause Claude judging (local models take over) once the 5-hour window is this full.
AUTOCLIPPER_JUDGE_MAX_5H=0.9
# Keep a clip when the judge scores it this high (0 = use the model's keep flag)
AUTOCLIPPER_KEEP_MIN_SCORE=7
# ...or once the weekly window is this full.
AUTOCLIPPER_JUDGE_MAX_7D=0.6
# Run caps over every ledger row ever (data/judge-ledger.sqlite), failures included.
AUTOCLIPPER_RUN_MAX_HAIKU=300
AUTOCLIPPER_RUN_MAX_SONNET=40
AUTOCLIPPER_JUDGE_TIMEOUT=120
# Fallback judge: qwen3:8b on text; 1 = qwen3.8-27b on frames (slow). Models are never pulled.
AUTOCLIPPER_OLLAMA_VISION=0
AUTOCLIPPER_OLLAMA_URL=http://127.0.0.1:11434

# Where replays are read from (read-only) and where outputs go.
AUTOCLIPPER_REPLAY_DIR=/mnt/c/Users/jayvi/Videos
AUTOCLIPPER_OUTPUT_DIR=/mnt/c/Users/jayvi/Videos/autoclipper

# Review page. 4180 is registered for autoclipper in ports.toml; it binds 127.0.0.1 and fails if taken.
AUTOCLIPPER_HOST=127.0.0.1
AUTOCLIPPER_PORT=4180
