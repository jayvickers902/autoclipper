# Installed by hand, see deploy/README.md. The hub: review page (port 4180, `ports get autoclipper`) plus the
# watch loop. No secrets here: Settings reads /home/jay/projects/autoclipper/.env itself.
[Unit]
Description=autoclipper hub (review page + replay watcher)
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=jay
WorkingDirectory=/home/jay/projects/autoclipper
Environment=HOME=/home/jay
# claude + uv: /home/jay/.local/bin, ffmpeg: /usr/bin, powershell.exe (GPU gate): the WindowsPowerShell dir
Environment=PATH=/home/jay/.local/bin:/usr/local/bin:/usr/bin:/bin:/mnt/c/Windows/System32/WindowsPowerShell/v1.0
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
ExecStart=/home/jay/.local/bin/uv run autoclipper run
# SIGTERM: the hub finishes the replay in progress, then exits; stages are resumable if it is killed instead.
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
